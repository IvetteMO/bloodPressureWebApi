<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas automatizadas del backend (xUnit v3).
    Se ejecutan desde Visual Studio: Prueba > Ejecutar todas las pruebas,
    o en consola: dotnet test

    No llaman a MATLAB ni a SQL Server: usan una base de datos en memoria,
    así que corren en segundos y en cualquier máquina.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <!-- Para que el Explorador de pruebas de Visual Studio las encuentre -->
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\bloodPressureWebApi\bloodPressureWebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
